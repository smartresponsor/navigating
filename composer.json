{
  "name": "navigating/navigation",
  "description": "Navigating process app",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "cruding/crud": "dev-master",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/orm": "^3.3",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "psr/cache": "^3.0",
    "psr/log": "^3.0",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/yaml": "^8.1"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Navigating\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Navigating\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "qa:navigating-easyadmin": "@php vendor/bin/phpunit tests/NavigationEasyAdminSurfaceTest.php tests/NavigationEasyAdminSymfonyTypeTest.php tests/NavigationEasyAdminBoundaryTest.php",
    "qa:navigating-database": "@php vendor/bin/phpunit tests/NavigationDatabaseBackedModelTest.php tests/NavigationRecoveryContractTest.php tests/NavigationConcurrencyContractTest.php tests/NavigationAcceptanceContractTest.php tests/NavigationTreeInvariantTest.php tests/NavigationTargetInvariantTest.php tests/NavigationEntityInvariantTest.php tests/NavigationLegacyMigrationContractTest.php tests/NavigationLegacyMigrationSemanticTest.php tests/NavigationLegacySqliteLifecycleTest.php",
    "qa:navigating-runtime": "@php vendor/bin/phpunit tests/NavigationRuntimeActivationTest.php tests/NavigationRuntimeActivationConfigTest.php",
    "navigation:fixtures": "@php bin/console doctrine:fixtures:load --group=navigating --append --no-interaction",
    "navigation:backup": "@php bin/console navigation:backup:create",
    "navigation:manifest:write": "@php bin/console navigation:manifest:write",
    "navigation:manifest:restore": "@php bin/console navigation:manifest:restore --force",
    "navigation:legacy:plan": "@php bin/console navigation:database:legacy-plan",
    "navigation:schema:update": "@php bin/console navigation:database:update",
    "navigation:rebuild": "@php bin/console navigation:database:rebuild --force",
    "navigation:schema:safe": [
      "@navigation:backup",
      "@navigation:schema:update"
    ],
    "navigation:acceptance:preflight": [
      "@php bin/console lint:container",
      "@navigation:legacy:plan",
      "@qa"
    ],
    "navigation:acceptance:verify": [
      "@php bin/console doctrine:schema:validate",
      "@php bin/console navigation:manifest:verify",
      "@qa"
    ],
    "qa": [
      "@qa:navigating-easyadmin",
      "@qa:navigating-database",
      "@qa:navigating-runtime"
    ]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*",
      "bundles": {
        "App\\Navigating\\NavigatingBundle": [
          "all"
        ]
      }
    },
    "smart-responsor": {
      "component": "navigation",
      "surface": "navigation",
      "standalone": true,
      "host_attachable": true
    }
  }
}
